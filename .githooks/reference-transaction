#!/usr/bin/env bash
# =============================================================================
# Repositório de coordenação — reference-transaction: guarda da ref `main`
# =============================================================================
# O pre-commit só roda em `git commit`. A `main` do repositório de coordenação
# (o que guarda o quadro e a documentação, sem remote) também anda por
# `git merge` (fast-forward ou merge commit), por `git update-ref` (o quadro.sh
# por plumbing, e a publicação com o checkout principal sujo da skill
# estado-compartilhado-multi-agente §7) e por `git reset`. Nenhum desses passa
# pelo pre-commit. Caso de origem (2026-10-23): cinco publicações seguidas
# entraram na `main` por update-ref sem nenhum gate rodar sobre o resultado.
#
# Este hook roda em TODA transação de ref (git ≥ 2.28). Para qualquer ref que
# não seja `refs/heads/main` ele sai em silêncio (medido: commit, merge e
# update-ref na main chegam como `refs/heads/main`; commit com HEAD solto chega
# só como `HEAD`). Para a main, no estado "prepared" (o único em que o exit code
# conta), recusa:
#   1. apagar a main;
#   2. mover a main para um commit que não descende da atual (reset, rewrite,
#      push --force local). O valor "old" do stdin vem zerado em atualização
#      forçada, por isso a comparação é contra `git rev-parse refs/heads/main`;
#   3. árvore nova que reprova os gates de documentação, rodados SÓ sobre o que
#      mudou e SOBRE O COMMIT, não sobre o disco (update-ref não toca o disco):
#      `check_skills.py --rev` (se o projeto o tiver em .githooks/, para
#      SKILL.md alterado) e o verificador de links (`check_doc_refs.py --root`
#      do projeto, senão `.harness/documentation.py check`) sobre um export da
#      árvore nova, se algum .md mudou.
#   4. árvore nova que leva `.dart` sem PARSE (desde 2026-11-26): `flutter
#      analyze` só roda no push e só quando a faixa enviada toca `apps/`, então
#      um merge/update-ref levava o app quebrado para a main sem verificação.
#      O verificador é `tools/verificar_dart.sh` LIDO DA ÁRVORE NOVA, com o
#      `dart format` (rc>=2 = erro de parse; rc=1 é só formatação e não bloqueia).
#
# Exceção consciente, no padrão do arquivo (aparece nomeada no terminal):
#     HARNESS_SKIP=main-ref git ...       (HARNESS_SKIP=docrefs pula só os links)
#     HARNESS_SKIP=dart ...               (pula só a sintaxe Dart)
# =============================================================================
set -uo pipefail

[ "${1:-}" = "prepared" ] || exit 0

ZERO='0000000000000000000000000000000000000000'
# Marca da transacao de RECRIACAO da main. O `git pack-refs` emite, na MESMA
# execucao, primeiro `<ZERO> <sha> refs/heads/main` e depois
# `<sha> <ZERO> refs/heads/main` — o "tira do loose, escreve no packed". A
# segunda le como DELECAO e o hook bloqueava, derrubando a manutencao automatica
# do git com "error: task 'pack-refs' failed" (reproduzido em 2026-11-26: 3
# transacoes, reflog_action vazio, nenhum discriminador no ambiente). A marca
# separa as duas: recriacao fresca => a "delecao" seguinte e o mesmo comando.
MARCA="${TMPDIR:-/tmp}/sovereign-main-repack-$(id -u).stamp"
JANELA_MARCA_S=5

novo=""; recriou=""
while read -r velho n ref; do
    [ "$ref" = "refs/heads/main" ] || continue
    if [ "$velho" = "$ZERO" ] && [ "$n" != "$ZERO" ]; then
        recriou="$n"
        continue
    fi
    novo="$n"
done
if [ -n "$recriou" ]; then
    printf '%s %s\n' "$(date +%s)" "$recriou" > "$MARCA" 2>/dev/null || true
fi
[ -n "$novo" ] || exit 0

case ",${HARNESS_SKIP:-}," in
    *,main-ref,*|*,all,*)
        echo "main-ref: guarda da main pulada (HARNESS_SKIP)" >&2
        exit 0
        ;;
esac


AQUI=$(cd "$(dirname "$0")" && pwd)
RED='\033[0;31m'; YELLOW='\033[1;33m'; NC='\033[0m'

bloqueia() {
    {
        echo ""
        echo -e "${RED}❌ MAIN NÃO ATUALIZADA — guarda da ref${NC}"
        printf '%b\n' "$1"
        if [ -n "${mudou:-}" ] && [ -n "${atual:-}" ]; then
            echo ""
            echo "Atenção: num \`git merge\` recusado, o git JÁ escreveu o conteúdo novo na árvore"
            echo "de trabalho (só a ref ficou parada). NÃO use \`reset --hard\` no checkout principal:"
            echo "ele apaga também o trabalho não commitado de outras sessões. Restaure só estes:"
            echo "    git restore --source=main --staged --worktree -- \\"
            printf '%s\n' "$mudou" | head -40 | sed 's/^/        /'
        fi
        echo ""
        echo -e "${YELLOW}Se a exceção for consciente:  HARNESS_SKIP=main-ref git ...${NC}"
        echo ""
    } >&2
    exit 1
}

case "$novo" in
    *[!0]*) ;;
    *)
        # new zerado. E re-pack do MESMO comando (marca fresca com o MESMO sha)?
        if [ -f "$MARCA" ]; then
            lido=$(cat "$MARCA" 2>/dev/null || true)
            marca_quando=${lido%% *}
            marca_sha=${lido#* }
            if [ -n "$marca_quando" ] && [ "$(( $(date +%s) - marca_quando ))" -le "$JANELA_MARCA_S" ] \
               && [ -n "$marca_sha" ] && [ "$marca_sha" = "$(git rev-parse -q --verify refs/heads/main 2>/dev/null || true)" ]; then
                rm -f "$MARCA" 2>/dev/null || true
                exit 0
            fi
        fi
        bloqueia "Esta operação APAGARIA a branch \`main\`."
        ;;
esac

mudou=""
atual=$(git rev-parse -q --verify refs/heads/main 2>/dev/null || true)
[ -n "$atual" ] && [ "$atual" = "$novo" ] && exit 0
if [ -n "$atual" ] && ! git merge-base --is-ancestor "$atual" "$novo" 2>/dev/null; then
    bloqueia "A main iria de ${atual:0:7} para ${novo:0:7}, que NÃO descende dela.\nIsso reescreve história compartilhada: o que outras sessões já leram, ou já\nmergearam, some da main sem conflito. A main só avança.\nPara desfazer algo, faça um commit novo (git revert) numa branch e mergeie."
fi

if [ -n "$atual" ]; then
    mudou=$(git diff --name-only "$atual" "$novo" 2>/dev/null)
else
    mudou=$(git ls-tree -r --name-only "$novo" 2>/dev/null)
fi

# Here-string, nunca `printf | grep -q`: com pipefail e dado grande o grep -q
# fecha o pipe cedo e o pipeline "falha" (medido 200/200) — o gate seria pulado.
if [ -f "$AQUI/check_skills.py" ] && grep -qE 'SKILL\.md$' <<<"$mudou"; then    if ! saida=$(python3 "$AQUI/check_skills.py" --rev "$novo" ${atual:+--base-rev "$atual"} 2>&1); then
        bloqueia "Gate skills reprovou a árvore nova:\n$saida"
    fi
fi

case ",${HARNESS_SKIP:-}," in
    *,docrefs,*) mudou_md=""; echo "main-ref: docrefs pulado (HARNESS_SKIP)" >&2 ;;
    *) mudou_md=$(grep -E '\.md$' <<<"$mudou" || true) ;;
esac
raiz=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
raiz=${raiz%/.git}
if [ -f "$AQUI/check_doc_refs.py" ]; then
    verificador=("$AQUI/check_doc_refs.py" --root)
elif [ -f "$raiz/.harness/documentation.py" ]; then
    verificador=("$raiz/.harness/documentation.py" --root)
else
    verificador=()
fi
if [ -n "$mudou_md" ] && [ ${#verificador[@]} -gt 0 ]; then
    tmp=$(mktemp -d) || bloqueia "mktemp falhou — sem verificação, sem atualização da main"
    trap 'rm -rf "$tmp"' EXIT
    if ! git archive "$novo" | tar -x -C "$tmp" 2>/dev/null; then
        bloqueia "não consegui exportar a árvore ${novo:0:7} para verificar os docs"
    fi
    # Num meta-repo, os docs podem apontar para repositórios de código vizinhos,
    # que não estão na árvore exportada: expõe os que existem no checkout real.
    for d in "$raiz"/*/; do
        d=${d%/}
        [ -e "$d/.git" ] && [ ! -e "$tmp/$(basename "$d")" ] && ln -s "$d" "$tmp/$(basename "$d")"
    done
    env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE git init -q "$tmp" 2>/dev/null
    verificador+=("$tmp")
    case "${verificador[0]}" in */documentation.py) verificador+=(check) ;; esac
    if ! saida=$(cd "$tmp" && env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE python3 "${verificador[@]}" 2>&1); then
        bloqueia "Gate docrefs reprovou a árvore nova:\n$saida"
    fi
fi

# =========================================================================
# Gate dart — o movimento da main não pode levar .dart que não faz PARSE
# =========================================================================
# Caso de origem (2026-11-26): `song_reader_page.dart` ficou com sintaxe
# quebrada na main (commit `b6a9864`) e NENHUM gate reprovou, porque `cargo
# test --workspace` estava verde — nenhum gate Rust enxerga Dart. O gate
# `flutter` do pre-push morde, mas só roda no PUSH e só quando a faixa enviada
# toca `apps/`; a main também anda por merge/update-ref, e por aí o arquivo
# quebrado passa sem verificação. A guarda da ref é o único ponto por onde TODO
# movimento da main passa.
#
# O verificador é lido DA ÁRVORE NOVA (`git cat-file`/`git show`), não do disco:
# um worktree atrasado não fica sem gate, e o gate que governa o movimento é o
# que o próprio movimento traz. Custo medido: `dart format` em 25 arquivos =
# 0,04 s, sem export da árvore. Reprova só ERRO DE PARSE (rc >= 2); `rc=1` é
# formatação, e 12 de 25 arquivos já estão fora do padrão hoje.
#
# Exceção consciente, no padrão do arquivo: HARNESS_SKIP=dart
case ",${HARNESS_SKIP:-}," in
    *,dart,*|*,all,*) echo "main-ref: dart pulado (HARNESS_SKIP)" >&2 ;;
    *)
        if grep -qE '\.dart$' <<<"$mudou"; then
            if git cat-file -e "$novo:tools/verificar_dart.sh" 2>/dev/null; then
                vd=$(mktemp) || bloqueia "mktemp falhou — sem verificação de sintaxe Dart, a main não avança"
                trap 'rm -rf "${tmp:-}" "$vd"' EXIT
                if ! git show "$novo:tools/verificar_dart.sh" > "$vd" 2>/dev/null; then
                    bloqueia "não consegui ler tools/verificar_dart.sh de ${novo:0:7}"
                fi
                if ! saida=$(cd "$raiz" && DART_BIN="${DART_BIN:-}" bash "$vd" --novo "$novo" ${atual:+--atual "$atual"} 2>&1); then
                    bloqueia "Gate dart: este movimento da main leva .dart que NÃO faz parse.\\n$saida"
                fi
            elif [ -n "$atual" ] && git cat-file -e "$atual:tools/verificar_dart.sh" 2>/dev/null; then
                bloqueia "Este movimento REMOVE \`tools/verificar_dart.sh\` e altera .dart.\\nUm gate não pode ser desligado pelo movimento que ele guarda. Se a remoção é\\nconsciente, use HARNESS_SKIP=dart."
            fi
        fi
        ;;
esac

# =========================================================================
# Gate changelog — o movimento da main NÃO pode APAGAR seção do CHANGELOG
# =========================================================================
# Caso de origem (2026-11-26): o merge `71a0b1b` apagou duas seções e uma
# subseção minhas do `CHANGELOG.md`, e o `origin/main` ficou sem elas. O `git`
# não acusa — deleção de um lado, sem mudança do outro, é aplicada — e
# `git log A..B` continua dizendo que está tudo lá, porque o que se perde é
# conteúdo dentro de arquivo. A guarda da ref é o único ponto por onde TODO
# movimento da main passa (merge, update-ref, reset), e por isso o gate vive
# aqui; o pre-commit cobre o mesmo para o commit na branch.
# Exceção consciente, no padrão do arquivo: HARNESS_SKIP=changelog
if [ -n "$atual" ] && grep -qx 'CHANGELOG\.md' <<<"$mudou" && [ -f "$AQUI/check_changelog.py" ]; then
    case ",${HARNESS_SKIP:-}," in
        *,changelog,*|*,all,*)
            echo "main-ref: changelog pulado (HARNESS_SKIP)" >&2
            ;;
        *)
            if ! saida=$(python3 "$AQUI/check_changelog.py" --base "$atual" --novo "$novo" 2>&1); then
                bloqueia "Gate changelog: este movimento da main APAGA seção do CHANGELOG.\n$saida"
            fi
            ;;
    esac
fi

exit 0
