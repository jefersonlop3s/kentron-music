# Rust
/target
**/*.rs.bk

# Flutter / Dart
.dart_tool/
.packages
build/
pubspec.lock
.flutter-plugins
.flutter-plugins-dependencies
**/ios/Pods/
**/android/.gradle/
**/android/local.properties

# Localizações geradas por `flutter gen-l10n` (reproduzíveis a partir dos ARBs)
packages/core_l10n/lib/l10n/app_localizations*.dart

# Segredos e credenciais de publicação (nunca versionar)
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
.env
.env.*
# o modelo versionado é o único `.env*` que pode entrar
!.env.example
# direnv carrega `.envrc`, que também pode ter segredo
.envrc
key.properties

# Modelos de IA baixados (ver models/MANIFEST.toml)
models/*.onnx
models/*.ort
models/*.tflite
models/*.bin
models/weights/

# Python — ferramentas e medidores
# `__pycache__/` aparecia como untracked em dois worktrees e podia entrar num
# `git add` distraído (medido em 2026-11-27, ao conferir a limpeza da sessão).
__pycache__/
*.pyc

# Editor / SO
.DS_Store
.idea/
.vscode/
*.swp
